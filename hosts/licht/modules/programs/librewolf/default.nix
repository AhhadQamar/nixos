# LibreWolf: the only browser, so everything lives in this one module.
#
#   default.nix   this file: policies, extensions, profile, prefs
#   config/       userChrome.css and tridactylrc, read below
#
# Edit a policy or extension in `policies`, a per-profile pref in
# `profiles.default.settings`, and a browser-wide pref in `settings`.
{pkgs, ...}: let
  pywalfoxNative = pkgs.pywalfox-native.overrideAttrs (old: {
    postInstall =
      (old.postInstall or "")
      + ''
        mkdir -p $out/lib/mozilla/native-messaging-hosts
        cat > $out/lib/mozilla/native-messaging-hosts/pywalfox.json <<EOF
        {
          "name": "pywalfox",
          "description": "Automatically theme your browser using the colors generated by Pywal",
          "path": "$out/bin/pywalfox",
          "type": "stdio",
          "allowed_extensions": [ "pywalfox@frewacom.org" ]
        }
        EOF
      '';
  });
in {
  # The `pywalfox` command must be on PATH: Hyprland's autostart runs
  # `pywalfox start`. (The native-messaging manifest the browser uses is
  # wired in through nativeMessagingHosts below, not through this.)
  home.packages = [pywalfoxNative];

  # Tridactyl reads ~/.config/tridactyl/tridactylrc through its native
  # messenger. The file is a read-only link into the Nix store, so edit
  # config/tridactylrc and rebuild (or `:source` after `ut`).
  xdg.configFile."tridactyl/tridactylrc".source = ./config/tridactylrc;

  programs.librewolf = {
    enable = true;

    # Native messengers for Pywalfox (wallpaper colours) and Tridactyl (vim keys).
    nativeMessagingHosts = [pywalfoxNative pkgs.tridactyl-native];

    # A fresh profile at ~/.librewolf/default.
    profiles.default = {
      id = 0;
      name = "default";
      isDefault = true;

      # Rounded controls and spacing only. Colours come from Pywalfox, so they
      # follow the wallpaper with no restart. See config/userChrome.css.
      userChrome = builtins.readFile ./config/userChrome.css;

      # Per-profile prefs, written to user.js so they are re-applied on every start.
      # DNS over HTTPS is set here too: LibreWolf turns DoH off by default, so the
      # policy's DNSOverHTTPS block alone may not win. mode 2 = use DoH, fall back
      # to normal DNS if the provider is unreachable.
      settings = {
        "browser.tabs.insertAfterCurrent" = true; # new tabs open next to the current one

        "network.trr.mode" = 2;
        "network.trr.uri" = "https://dns.quad9.net/dns-query";

        # Containers (Multi-Account Containers needs both). Firefox has them
        # on already; they are pinned here so a hardening profile can never
        # turn them off. Nothing here touches cookies or fingerprinting, so
        # Google sign-in is unaffected: it just happens once per container.
        "privacy.userContext.enabled" = true;
        "privacy.userContext.ui.enabled" = true;
      };
    };

    # LibreWolf is stricter than Firefox out of the box. These undo the parts
    # that make it behave differently as a daily driver, so it acts like Firefox.
    # Each line says what it costs; flip any back to true to harden again.
    # Reference: https://librewolf.net/docs/settings/
    settings = {
      # Keep cookies, history and logins between restarts. LibreWolf wipes them
      # on every quit by default, which logs you out of everything.
      "privacy.sanitize.sanitizeOnShutdown" = false;

      # Allow Firefox Sync (bookmarks, passwords, history), which LibreWolf
      # disables by default. Sign in from the menu after the first start.
      "identity.fxaccounts.enabled" = true;

      # Resist-fingerprinting makes sites see UTC, a light colour scheme and a
      # letterboxed window. Off, to match Firefox. The tracking-protection
      # policy still blocks fingerprinters, as it does in Firefox.
      "privacy.resistFingerprinting" = false;
      "privacy.resistFingerprinting.letterboxing" = false;

      # WebGL is off in LibreWolf; many sites and web apps need it.
      "webgl.disabled" = false;

      # Session restore ("reopen closed tabs", crash recovery) also keeps what
      # you typed into forms and session logins, as in Firefox. 0 = store all.
      "browser.sessionstore.privacy_level" = 0;

      # Keep the page cache on disk, as Firefox does, so repeat visits and
      # large sites load faster instead of re-downloading after each restart.
      "browser.cache.disk.enable" = true;

      # Offer to save and fill logins and form entries, as Firefox does.
      "signon.rememberSignons" = true;
      "browser.formfill.enable" = true;

      # Fixes SEC_ERROR_OCSP_SERVER_ERROR on sites whose certificate checker is
      # down: treat an unreachable revocation server as "not revoked" instead
      # of refusing to load the page. This is Firefox's behaviour.
      "security.OCSP.require" = false;

      # Google Safe Browsing (malware and phishing warnings), on in Firefox and
      # off in LibreWolf. It asks Google about hashed URL prefixes, not full
      # addresses. Remove these two lines to keep LibreWolf's stricter default.
      "browser.safebrowsing.malware.enabled" = true;
      "browser.safebrowsing.phishing.enabled" = true;

      # Hardware video decoding (VA-API) for smoother YouTube and lower CPU use.
      # Falls back to software if your GPU or driver cannot do it.
      "media.ffmpeg.vaapi.enabled" = true;
    };

    # Browser-wide settings that Firefox Sync does not carry.
    # Bookmarks, passwords and history stay with Firefox Sync, so none are set here.
    policies = {
      # --- New tab and new window ---
      # The "very minimal new tab" extension (newtab@licht.local, installed by
      # the ExtensionSettings entry below) shows its page on a new tab (Ctrl+T)
      # and, through chrome_settings_overrides in its manifest, as the home page
      # for new windows (Ctrl+N). Nothing here may set a home page, or it would
      # fight the extension.
      # NewTabPage = false keeps the browser's own new tab page off.
      NewTabPage = false;

      # --- Less noise ---
      DontCheckDefaultBrowser = true;
      OverridePostUpdatePage = ""; # no "what's new" tab after every browser update
      UserMessaging = {
        ExtensionRecommendations = false;
        FeatureRecommendations = false;
        UrlbarInterventions = false;
        MoreFromMozilla = false;
        SkipOnboarding = true;
      };

      # --- Data sent to Mozilla ---
      # (Mozilla recommends leaving telemetry on; remove these if you prefer)
      DisableTelemetry = true;
      DisableFirefoxStudies = true;
      FirefoxSuggest = {WebSuggestions = false;}; # turns Suggest off completely

      # --- Tracking ---
      # Block known trackers in every window, not just private ones. Locked = false
      # keeps the shield icon usable: click it to turn protection off for one site.
      EnableTrackingProtection = {
        Value = true;
        Locked = false;
        Cryptomining = true;
        Fingerprinting = true;
        EmailTracking = true;
        SuspectedFingerprinting = true;
        BaselineExceptions = true; # automatic fixes for major breakage
        ConvenienceExceptions = true; # automatic fixes for minor breakage
      };

      # --- Connections ---
      HttpsOnlyMode = "enabled"; # warns before loading plain http (you can click through)
      NetworkPrediction = false; # no DNS prefetching of links you have not clicked
      SearchSuggestEnabled = false; # typing in the address bar is not sent to the search engine

      # DNS over HTTPS: your ISP no longer sees which sites you look up.
      # Fallback = true uses normal DNS if the provider is unreachable.
      # Swap the URL for https://mozilla.cloudflare-dns.com/dns-query if you prefer Cloudflare.
      DNSOverHTTPS = {
        Enabled = true;
        ProviderURL = "https://dns.quad9.net/dns-query";
        Fallback = true;
        Locked = false;
      };

      # --- Site permissions ---
      # Sites can no longer even ask. Already granted permissions are kept.
      Permissions = {
        Location = {BlockNewRequests = true;};
        Notifications = {BlockNewRequests = true;};
        # Sites cannot start any video or audio until you click. Click play once
        # (or allow the site from the address bar) and it works on that site.
        Autoplay = {Default = "block-audio-video";};
      };

      # about:config values. Status "default" means you can still change them in the UI.
      Preferences = {
        "privacy.globalprivacycontrol.enabled" = {
          Value = true; # tells sites you opt out of sale/sharing of your data
          Status = "default";
        };
      };

      # --- Extensions that must exist on a fresh install ---
      # normal_installed: you can still disable them, and Sync will not duplicate them.
      ExtensionSettings = {
        "pywalfox@frewacom.org" = {
          installation_mode = "normal_installed";
          install_url = "https://addons.mozilla.org/firefox/downloads/latest/pywalfox@frewacom.org/latest.xpi";
        };
        # LibreWolf already ships uBlock Origin, so this entry is a no-op.
        "uBlock0@raymondhill.net" = {
          installation_mode = "normal_installed";
          install_url = "https://addons.mozilla.org/firefox/downloads/latest/uBlock0@raymondhill.net/latest.xpi";
        };
        # New tab and new window page (see NewTabPage above). The ID is the
        # extension's own; the URL always serves the newest signed version.
        "newtab@licht.local" = {
          installation_mode = "normal_installed";
          install_url = "https://addons.mozilla.org/firefox/downloads/latest/very-minimal-new-tab/latest.xpi";
        };
        # Multi-Account Containers: every container has its own cookie jar, so
        # each Google account signs in separately. That gets around the limit of
        # 10 Google accounts per browser session, and it never mixes logins.
        # The ID is the add-on's own. Containers are created in its toolbar
        # panel; see the README section "Many Google accounts".
        "@testpilot-containers" = {
          installation_mode = "normal_installed";
          install_url = "https://addons.mozilla.org/firefox/downloads/latest/multi-account-containers/latest.xpi";
        };
        # Vim-style keys. The ID must match the installed add-on: check it with
        # `grep -o 'tridactyl[^"]*@[^"]*' <profile>/extensions.json` before the rebuild.
        "tridactyl.vim@cmcaine.co.uk" = {
          installation_mode = "normal_installed";
          install_url = "https://addons.mozilla.org/firefox/downloads/latest/tridactyl-vim/latest.xpi";
        };
      };
    };
  };
}
