#!/usr/bin/env bash
set -e

cd /etc/nixos

echo "Formatting..."
alejandra . &>/dev/null

echo "Scanning for secrets before commit..."
nix shell nixpkgs#gitleaks -c gitleaks detect --source . -v

echo "NixOS Rebuilding..."
nh os switch &>nh-switch.log || (cat nh-switch.log | grep --color error && false)

gen=$(nixos-rebuild list-generations | awk '$NF == "True" {print $1}')
git add -A

if git diff --cached --quiet; then
  echo "Nothing to commit"
else
  changed=$(git diff --cached --name-only)
  read -p "Commit message (leave blank for generation number): " msg
  subject="${msg:-NixOS generation $gen}"
  git commit -m "$subject" -m "Changed:
$changed"
fi

git push
